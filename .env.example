# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=                  # Permanent access token from Meta App dashboard
WHATSAPP_PHONE_NUMBER_ID=        # From Meta App > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=           # Any string you choose, used during webhook verification
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- WooCommerce (onlineprintingz.in) ---
WC_BASE_URL=https://onlineprintingz.in
WC_CONSUMER_KEY=                 # WooCommerce > Settings > Advanced > REST API
WC_CONSUMER_SECRET=

# --- WordPress (for media/file upload + direct DB reads) ---
WP_BASE_URL=https://onlineprintingz.in
WP_APPLICATION_USERNAME=
WP_APPLICATION_PASSWORD=

# --- Direct DB access (for WCPC pricing tables - optional but faster than REST) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Server ---
PORT=3000
